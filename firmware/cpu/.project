<?xml version="1.0" encoding="UTF-8"?>
<projectDescription>
	<name>autd3-cpu-fw</name>
	<comment>AUTD3 CPU firmware (RZ/T1 R7S910018, Cortex-R4F). Built by `cargo xtask cpu build`; this project is for editing and J-Link debugging in e2 studio.</comment>
