IMG_NAME="@IMG_NAME@"
IMG_FILENAME="@IMG_NAME@"
ARCHIVE_FILENAME="@IMG_NAME@"
RELEASE="@RELEASE@"
ARCH="arm64"

TARGET_HOSTNAME="autd3"
LOCALE_DEFAULT="en_US.UTF-8"
KEYBOARD_KEYMAP="us"
KEYBOARD_LAYOUT="English (US)"
TIMEZONE_DEFAULT="Etc/UTC"

STAGE_LIST="stage0 stage1 stage2 stage-autd3"

DISABLE_FIRST_BOOT_USER_RENAME=1
FIRST_USER_NAME="support"
FIRST_USER_PASS="@USER_PASS@"
export AUTD3_LOCK_ACCOUNT="@LOCK_ACCOUNT@"

ENABLE_SSH=1
@SSH_PUBKEY@

DEPLOY_COMPRESSION="xz"
COMPRESSION_LEVEL=6
