from collections.abc import Callable, Hashable, Iterator, Mapping, Sequence
from typing import Any, ClassVar, Generic, TypeAlias, TypeVar, final, overload

import numpy as np
import numpy.typing as npt
from autd3_core import Angle, Device, Geometry, Intensity, Length, Phase, Velocity

_K = TypeVar("_K", bound=Hashable)
_Vec3: TypeAlias = Sequence[float] | npt.NDArray[np.floating[Any]]

@final
class DevicePhaseView:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Phase: ...
    def __iter__(self) -> Iterator[Phase]: ...
    def __setitem__(self, index: int, value: Phase | int) -> None: ...

@final
class PhaseBuffer:
    def __new__(cls, num_devices: int) -> PhaseBuffer: ...
    @staticmethod
    def from_array(values: npt.NDArray[np.uint8] | Sequence[Sequence[Phase | int]]) -> PhaseBuffer: ...
    def copy_from(self, values: npt.NDArray[np.uint8]) -> None: ...
    def to_numpy(self) -> npt.NDArray[np.uint8]: ...
    def num_devices(self) -> int: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> DevicePhaseView: ...
    def __iter__(self) -> Iterator[DevicePhaseView]: ...
    def _capsule(self) -> object: ...

@final
class DeviceIntensityView:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> Intensity: ...
    def __iter__(self) -> Iterator[Intensity]: ...
    def __setitem__(self, index: int, value: Intensity | int) -> None: ...

@final
class IntensityBuffer:
    def __new__(cls, num_devices: int) -> IntensityBuffer: ...
    @staticmethod
    def from_array(values: npt.NDArray[np.uint8] | Sequence[Sequence[Intensity | int]]) -> IntensityBuffer: ...
    def copy_from(self, values: npt.NDArray[np.uint8]) -> None: ...
    def to_numpy(self) -> npt.NDArray[np.uint8]: ...
    def num_devices(self) -> int: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> DeviceIntensityView: ...
    def __iter__(self) -> Iterator[DeviceIntensityView]: ...
    def _capsule(self) -> object: ...

@final
class TransducerMask:
    AllEnabled: ClassVar[TransducerMask]
    @staticmethod
    def masked(mask: Sequence[Sequence[bool]]) -> TransducerMask: ...
    def validate(self, geometry: Geometry) -> None: ...
    def is_enabled(self, device: int, transducer: int) -> bool: ...
    def num_enabled(self, geometry: Geometry) -> int: ...

@final
class TransducerGroups(Generic[_K]):
    def __new__(cls, geometry: Geometry, key: Callable[[Device, int], _K]) -> TransducerGroups[_K]: ...
    def keys(self) -> list[_K]: ...
    def key(self, device: int, transducer: int) -> _K: ...
    def index(self, device: int, transducer: int) -> int: ...
    def indices(self, device: int) -> list[int]: ...
    def num_devices(self) -> int: ...
    def num_transducers(self, device: int) -> int: ...
    def num_transducers_in(self, key: _K) -> int: ...
    def masks(self) -> list[tuple[_K, TransducerMask]]: ...
    def mask(self, key: _K) -> TransducerMask: ...

@final
class LaguerreGaussianOption:
    def __new__(cls, p: int, l: int, waist: Length) -> LaguerreGaussianOption: ...
    @property
    def p(self) -> int: ...
    @property
    def l(self) -> int: ...
    @property
    def waist(self) -> Length: ...

@final
class HermiteGaussianOption:
    def __new__(cls, m: int, n: int, waist: Length) -> HermiteGaussianOption: ...
    @property
    def m(self) -> int: ...
    @property
    def n(self) -> int: ...
    @property
    def waist(self) -> Length: ...

def wavelength(sound_speed: Velocity) -> Length: ...
