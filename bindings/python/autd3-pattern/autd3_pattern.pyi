def group_compute(
    geometry: Geometry,
    groups: TransducerGroups[_K],
    compute: Callable[[_K, TransducerMask, PhaseBuffer, IntensityBuffer], object],
    phases: PhaseBuffer,
    intensities: IntensityBuffer,
) -> None: ...
