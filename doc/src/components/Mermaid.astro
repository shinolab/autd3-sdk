---
interface Props {
  code: string;
  title?: string;
}
const { code, title } = Astro.props;
---

<figure class="mermaid-figure">
  <div class="mermaid-figure-graph" data-mermaid-src={code}></div>
  {title && <figcaption>{title}</figcaption>}
</figure>

<script>
  import mermaid from "mermaid";

  let seq = 0;

  function themeFor(): "default" | "dark" {
    return document.documentElement.dataset.theme === "light" ? "default" : "dark";
  }

  function lightbox(): HTMLElement {
    let box = document.querySelector<HTMLElement>(".mermaid-lightbox");
    if (box) return box;
    box = document.createElement("div");
    box.className = "mermaid-lightbox";
    box.hidden = true;
    box.innerHTML = '<div class="mermaid-lightbox-graph"></div>';
    box.addEventListener("click", () => close());
    document.body.appendChild(box);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") close();
    });
    return box;
  }

  function close() {
    const box = document.querySelector<HTMLElement>(".mermaid-lightbox");
    if (!box) return;
    box.hidden = true;
    document.body.style.overflow = "";
  }

  function open(svg: string) {
    const box = lightbox();
    const graph = box.querySelector<HTMLElement>(".mermaid-lightbox-graph");
    if (!graph) return;
    graph.innerHTML = svg;
    // Mermaid pins the rendered width; drop it so the diagram fills the overlay.
    const el = graph.querySelector("svg");
    if (el) {
      el.removeAttribute("width");
      el.removeAttribute("height");
      el.style.maxWidth = "none";
    }
    box.hidden = false;
    document.body.style.overflow = "hidden";
  }

  async function renderAll() {
    const nodes = document.querySelectorAll<HTMLElement>(
      ".mermaid-figure-graph[data-mermaid-src]",
    );
    if (!nodes.length) return;
    mermaid.initialize({
      startOnLoad: false,
      theme: themeFor(),
      securityLevel: "strict",
      flowchart: { htmlLabels: true, curve: "basis" },
    });
    for (const el of nodes) {
      const src = el.dataset.mermaidSrc;
      if (!src) continue;
      try {
        const { svg } = await mermaid.render(`mermaid-${seq++}`, src);
        el.innerHTML = svg;
        el.tabIndex = 0;
        el.setAttribute("role", "button");
        el.setAttribute("aria-label", "図を拡大する");
        el.onclick = () => open(svg);
        el.onkeydown = (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            open(svg);
          }
        };
      } catch (e) {
        el.textContent = String(e);
      }
    }
  }

  renderAll();
  document.addEventListener("astro:page-load", renderAll);
  document.addEventListener("astro:before-swap", close);
  new MutationObserver(() => renderAll()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>

<style is:global>
  .mermaid-figure {
    margin: 1.5rem 0;
    text-align: center;
  }
  .mermaid-figure-graph {
    cursor: zoom-in;
    border-radius: 0.25rem;
  }
  .mermaid-figure-graph:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 4px;
  }
  /* Starlight's reset makes svg `display: block`, so `text-align` cannot centre it. */
  .mermaid-figure-graph svg {
    max-width: 100%;
    height: auto;
    margin-inline: auto;
  }
  .mermaid-figure figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .mermaid-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    background: rgb(0 0 0 / 80%);
    cursor: zoom-out;
  }
  .mermaid-lightbox[hidden] {
    display: none;
  }
  .mermaid-lightbox-graph {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mermaid-lightbox-graph svg {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
  }
</style>
